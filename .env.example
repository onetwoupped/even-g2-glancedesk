# Copy to .env and fill in your Telegram bot token from @BotFather
# Never commit .env!
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_DEFAULT_CHAT_ID=
PORT=8787
# Optional: OpenAI API key for real Whisper transcription of G2 mic PCM audio
# If omitted, GlanceDesk uses built-in local voice command confirmation mode
OPENAI_API_KEY=
