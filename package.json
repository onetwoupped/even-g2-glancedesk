{
  "name": "even-g2-glancedesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GlanceDesk for Even G2: Borderless multi-timeframe OHLC candlestick HUD with 2D risk numpad, auto-sized Hyperliquid paper perps, and Telegram sync.",
  "scripts": {
    "server": "node server/index.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "sim": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js http://127.0.0.1:5173",
    "pack:ehpk": "evenhub pack app.json dist -o glancedesk.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
